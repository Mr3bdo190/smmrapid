NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Firebase Admin (preferred in production)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# Email allowlist for initial/admin accounts
ADMIN_EMAILS=admin@example.com

# Payments
KASHIER_MERCHANT_ID=your_merchant_id
KASHIER_API_KEY=your_server_side_api_key
KASHIER_WEBHOOK_SECRET=your_webhook_secret
KASHIER_MODE=live
KASHIER_CHECKOUT_URL=https://checkout.kashier.io/
KASHIER_CURRENCY=EGP
CURRENCY=EGP

# Heleket crypto payments
HELEKET_MERCHANT_ID=your_heleket_merchant_uuid
HELEKET_PAYMENT_API_KEY=your_heleket_payment_api_key
HELEKET_CURRENCY=USD
HELEKET_INVOICE_LIFETIME=3600
PUBLIC_APP_URL=https://your-domain.example

# If Heleket uses a different currency from the wallet, set wallet units per 1 gateway unit. Example: 50 means 1 USD = 50 EGP.
HELEKET_TO_WALLET_RATE=50
# Optional: keep provider-less orders pending for manual fulfillment. Use only if you truly fulfill them manually.
MANUAL_FULFILLMENT=false
