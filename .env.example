# ─────────────────────────────────────────────────────────────────────────────
# SMM Rapid — environment variables
# Copy to .env for local development:  cp .env.example .env
# NEVER commit a filled .env. Production values live in the Render dashboard only.
# Full description of every variable: docs/ENVIRONMENT.md
# "Phase" = the phase in which the variable starts being required.
# ─────────────────────────────────────────────────────────────────────────────

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000

# ── database: Supabase PostgreSQL (Phase 2+) ─────────────────────────────────
# Pooled connection string (Supavisor, port 6543) used by the API server.
DATABASE_URL=
# Direct connection (port 5432) — used only for running migrations/seed SQL.
DATABASE_DIRECT_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-side only. Must never reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=

# ── authentication: Firebase Admin SDK (Phase 3+) ────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the quotes and the \n escapes: the key is a multi-line PEM string.
FIREBASE_PRIVATE_KEY=""

# ── web app: Firebase client config (Phase 3+) ───────────────────────────────
# Vite only exposes variables prefixed with VITE_ to the browser.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# ── encryption for provider credentials at rest (Phase 7+) ───────────────────
# 32+ random characters. Rotating this value invalidates stored provider secrets.
PROVIDER_ENCRYPTION_KEY=

# ── payments: Sh7nawy Gate — Vodafone / Orange / Etisalat cash (EGP) (Phase 9+) ──
# Public key authorises create/confirm, secret key authorises the status read.
# (SHAHNAWY_API_KEY is the old scaffold name and is still accepted.)
SHAHNAWY_BASE_URL=
SHAHNAWY_PUBLIC_KEY=
SHAHNAWY_SECRET_KEY=

# ── payments: Heleket crypto (USD) (Phase 9+) ────────────────────────────────
# HELEKET_API_KEY is the payment API key; HELEKET_PAYMENT_API_KEY is the old name.
HELEKET_MERCHANT_ID=
HELEKET_API_KEY=
HELEKET_BASE_URL=https://api.heleket.com

# Public origin used to build webhook + return URLs a gateway calls back.
PUBLIC_ORIGIN=https://smmrapid.store

# How often the in-process worker submits waiting orders and refreshes running ones (Phase 8b+).
# 0 switches the loop off; a manual tick is POST /api/admin/orders/dispatch.
ORDER_DISPATCH_INTERVAL_MS=60000

# ── SMM provider adapters (Phase 7+) ─────────────────────────────────────────
# One pair per configured provider; the provider row in the database stores which
# env keys it uses. Never hardcode an API key anywhere in the source tree.
PROVIDER_1_NAME=
PROVIDER_1_URL=
PROVIDER_1_API_KEY=
