NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Firebase Admin — SAME Firebase project as the VITE_FIREBASE_* values below.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
# Optional alternative to the three Admin values above:
FIREBASE_SERVICE_ACCOUNT_JSON=

# Firebase Web SDK — these are build-time variables for Vite/Render.
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-web-app-id
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Admin/support
ADMIN_EMAILS=admin@example.com
SUPPORT_EMAIL=support@example.com

# Payments
KASHIER_MERCHANT_ID=your_merchant_id
KASHIER_API_KEY=your_server_side_api_key
KASHIER_WEBHOOK_SECRET=your_webhook_secret
KASHIER_MODE=live
KASHIER_CHECKOUT_URL=https://checkout.kashier.io/
KASHIER_CURRENCY=EGP
CURRENCY=USD

# Heleket crypto payments
HELEKET_MERCHANT_ID=your_heleket_merchant_uuid
HELEKET_PAYMENT_API_KEY=your_heleket_payment_api_key
HELEKET_CURRENCY=USD
# Wallet units credited per 1 Heleket currency unit when currencies differ.
HELEKET_TO_WALLET_RATE=1
HELEKET_INVOICE_LIFETIME=3600
PUBLIC_APP_URL=https://your-domain.example

# Orders without a live provider remain pending only when this is explicitly enabled.
MANUAL_FULFILLMENT=false
