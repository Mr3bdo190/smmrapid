{
  "name": "smmrapid",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SMM Rapid — SMM panel platform (monorepo: API + web app)",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "dev:api": "npm run dev --workspace @smmrapid/api",
    "dev:web": "npm run dev --workspace @smmrapid/web",
    "start": "npm run start --workspace @smmrapid/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
